# ARC-AGI-3 EDD Agent Environment Variables

# --- Google Gemini / Vertex AI Settings ---
# Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Platform (GCP) Vertex AI Configuration (Optional)
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=us-central1

# --- EDD & Evaluation Settings ---
# EDD Log Level (DEBUG, INFO, WARNING, ERROR)
EDD_LOG_LEVEL=INFO

# Default LLM Model for Hypothesis Generation & Skill Evolution
DEFAULT_LLM_MODEL=gemini-2.5-flash
EVOLVER_LLM_MODEL=gemini-2.5-pro
