# =============================================================================
# ARC-AGI-3 EDD Agent — 環境変数テンプレート
# =============================================================================
# このファイルを .env にコピーして、各項目を設定してください。
#
#   cp .env.example .env
#   vi .env  (または任意のエディタで編集)
#
# 注意: .env ファイルは .gitignore に含まれており、
#       Git にコミットされません (認証情報の漏洩防止)。
# =============================================================================

# --- Google Gemini / Vertex AI Settings ---
# エージェントの仮説生成・自己進化ループで使用する LLM API キー

# Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Platform (GCP) Vertex AI Configuration (Optional)
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=us-central1

# --- Kaggle API Settings ---
# 公式データセットのダウンロード・提出に使用
# 取得方法: https://www.kaggle.com/settings → API → Create New Token

KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# --- EDD (Evaluation Driven Development) Settings ---

# EDD ログレベル (DEBUG, INFO, WARNING, ERROR)
EDD_LOG_LEVEL=INFO

# 仮説生成に使用する LLM モデル
DEFAULT_LLM_MODEL=gemini-2.5-flash

# スキル進化 (Evolver) に使用する LLM モデル
EVOLVER_LLM_MODEL=gemini-2.5-pro

# --- JupyterLab Settings ---

# JupyterLab のホスト側公開ポート (デフォルト: 8888)
JUPYTER_PORT=8888
