{
    "name": "ARC-AGI-3 EDD Agent (Kaggle GPU Compatible)",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "kaggle-dev",
    "workspaceFolder": "/workspace",
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "mounts": [
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.kaggle,target=/root/.kaggle,type=bind,consistency=cached",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/gh,target=/root/.config/gh,type=bind,consistency=cached"
    ],
    "containerEnv": {
        "NVIDIA_VISIBLE_DEVICES": "all",
        "NVIDIA_DRIVER_CAPABILITIES": "compute,utility"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "git.enableSmartCommit": true,
                "git.autofetch": true,
                "git.confirmSync": false,
                "python.defaultInterpreterPath": "/usr/bin/python3"
            },
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "charliermarsh.ruff"
            ]
        }
    },
    "forwardPorts": [
        8888
    ],
    "postCreateCommand": "pip install --no-cache-dir -e '.[dev]' && echo 'Setup complete!'",
    "remoteUser": "root"
}